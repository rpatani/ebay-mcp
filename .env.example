# ebay-mcp environment (copy to .env)
# NOTE: unlike weather/finance, every eBay tool needs an OAuth app token, so
# EBAY_CLIENT_ID/SECRET are required for any tool call to succeed.

MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp
MCP_KEYS_FILE=keys.example.json

MCP_METRICS_BACKEND=prometheus
MCP_METRICS_PORT=9464
LOG_LEVEL=info

MCP_UPSTREAM_TIMEOUT_S=4.0
MCP_UPSTREAM_RETRIES=2
MCP_BREAKER_THRESHOLD=5
MCP_BREAKER_COOLDOWN_S=30

# eBay OAuth client-credentials (from https://developer.ebay.com/ my-account/keys)
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id
# EBAY_MARKETPLACE_ID=EBAY_US
